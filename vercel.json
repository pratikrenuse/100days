{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/meet",
      "destination": "/schedule/index.html"
    },
    {
      "source": "/meet/",
      "destination": "/schedule/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/talks",
      "destination": "/speaking/",
      "permanent": true
    },
    {
      "source": "/talks/:path*",
      "destination": "/speaking/:path*",
      "permanent": true
    },
    {
      "source": "/100days",
      "destination": "/playbooks/",
      "permanent": true
    },
    {
      "source": "/100days/:path*",
      "destination": "/playbooks/",
      "permanent": true
    },
    {
      "source": "/roast-my-landing-page",
      "destination": "/playbooks/",
      "permanent": true
    },
    {
      "source": "/roast-my-landing-page/:path*",
      "destination": "/playbooks/",
      "permanent": true
    },
    {
      "source": "/journey",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inspirations",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo5",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo6",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/tool?fuel=1",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/tool?solo=1",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
