{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/meet",
      "destination": "/schedule/index.html"
    },
    {
      "source": "/meet/",
      "destination": "/schedule/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/talks",
      "destination": "/speaking/",
      "permanent": true
    },
    {
      "source": "/talks/:path*",
      "destination": "/speaking/:path*",
      "permanent": true
    }
  ]
}
