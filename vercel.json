{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/meet",
      "destination": "/schedule/index.html"
    },
    {
      "source": "/meet/",
      "destination": "/schedule/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/talks",
      "destination": "/speaking/",
      "permanent": true
    },
    {
      "source": "/talks/:path*",
      "destination": "/speaking/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/tool?fuel=1",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/tool?solo=1",
      "schedule": "0 0 * * *"
    }
  ]
}